{#
/**
 * @file
 * Bootstrap Barrio's theme implementation to display a node.
 *
 * Available variables:
 * - node: The node entity with limited access to object properties and methods.
     Only "getter" methods (method names starting with "get", "has", or "is")
     and a few common methods such as "id" and "label" are available. Calling
     other methods (such as node.delete) will result in an exception.
 * - label: The title of the node.
 * - content: All node items. Use {{ content }} to print them all,
 *   or print a subset such as {{ content.field_example }}. Use
 *   {{ content|without('field_example') }} to temporarily suppress the printing
 *   of a given child element.
 * - author_picture: The node author user entity, rendered using the "compact"
 *   view mode.
 * - metadata: Metadata for this node.
 * - date: Themed creation date field.
 * - author_name: Themed author name field.
 * - url: Direct URL of the current node.
 * - display_submitted: Whether submission information should be displayed.
 * - attributes: HTML attributes for the containing element.
 *   The attributes.class element may contain one or more of the following
 *   classes:
 *   - node: The current template type (also known as a "theming hook").
 *   - node--type-[type]: The current node type. For example, if the node is an
 *     "Article" it would result in "node--type-article". Note that the machine
 *     name will often be in a short form of the human readable label.
 *   - node--view-mode-[view_mode]: The View Mode of the node; for example, a
 *     teaser would result in: "node--view-mode-teaser", and
 *     full: "node--view-mode-full".
 *   The following are controlled through the node publishing options.
 *   - node--promoted: Appears on nodes promoted to the front page.
 *   - node--sticky: Appears on nodes ordered above other non-sticky nodes in
 *     teaser listings.
 *   - node--unpublished: Appears on unpublished nodes visible only to site
 *     admins.
 * - title_attributes: Same as attributes, except applied to the main title
 *   tag that appears in the template.
 * - content_attributes: Same as attributes, except applied to the main
 *   content tag that appears in the template.
 * - author_attributes: Same as attributes, except applied to the author of
 *   the node tag that appears in the template.
 * - title_prefix: Additional output populated by modules, intended to be
 *   displayed in front of the main title tag that appears in the template.
 * - title_suffix: Additional output populated by modules, intended to be
 *   displayed after the main title tag that appears in the template.
 * - view_mode: View mode; for example, "teaser" or "full".
 * - teaser: Flag for the teaser state. Will be true if view_mode is 'teaser'.
 * - page: Flag for the full page state. Will be true if view_mode is 'full'.
 * - readmore: Flag for more state. Will be true if the teaser content of the
 *   node cannot hold the main body content.
 * - logged_in: Flag for authenticated user status. Will be true when the
 *   current user is a logged-in member.
 * - is_admin: Flag for admin user status. Will be true when the current user
 *   is an administrator.
 *
 * @see template_preprocess_node()
 */
#}
{{ attach_library('bootstrap_barrio/node') }}

{% set content_type = node.type.value[0].target_id %}

{%
set classes = [
  'node',
  'node--type-' ~ node.bundle|clean_class,
  node.isPromoted() ? 'node--promoted',
  node.isSticky() ? 'node--sticky',
  not node.isPublished() ? 'node--unpublished',
  view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
  'clearfix',
]
%}

<article{{ attributes.addClass(classes) }}>
<header>
  {{ title_prefix }}
  {% if label and not page %}
    {% if not page %}
    <h2{{ title_attributes.addClass('node__title') }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h2>
    {% endif %}
  {% endif %}
  {{ title_suffix }}
  {% if display_submitted %}
  <div class="node__meta">
    {{ author_picture }}
    {% block submitted %}
    <em{{ author_attributes }}>
      {% trans %}Submitted by {{ author_name }} on {{ date }}{% endtrans %}
    </em>
    {% endblock %}
    {{ metadata }}
  </div>
  {% endif %}
</header>
<div{{ content_attributes.addClass('node__content', 'clearfix') }}>
  {% if content_type in ["work", "legacy_work", "playlist", "reader_collection", "rec_list"] %}
    {% set has_image = node.field_cover[0].entity.uri.value != null %}
    {% set filters_enabled = content_type in ["playlist", "reader_collection", "rec_list"] %}
    {% if node.field_rating is not empty %}
      {% if node.field_rating[0].entity.name.value not in ["General", "Teen and up"] %}
        {% set explicit_rating = true %}
      {% endif %}
    {% else %}
      {% set explicit_rating = true %}
    {% endif %}
    <div class="p-2 full-work {{ has_image ? '' : 'no-image' }} {{ filters_enabled ? 'filters-enabled' : '' }} {{ explicit_rating ? 'full-work-explicit' : '' }} full-work-{{ content_type|replace({'_': '-'}) }}">
      {# TODO: When the filters are placed above the rest of the content and hidden,
      their row gap is still rendered, so we get a double-height margin at the top of
      the page. To fix this I'll need to add some js listening to whether the filters
      are collapsed, and add a negative margin to the .full-work div based on that. #}
      <div class="contextual-menu">
        {{ drupal_block("node_contextual_menu", {context_mapping: {node: '@node.node_route_context:node'}}, wrapper=false) }}
        {% if content_type in ["work", "playlist", "reader_collection", "rec_list"] %}
          {% set url_prefix = {"work": "work", "playlist": "series", "reader_collection": "collection", "rec_list": "rec-list"} %}
          <a class="btn btn-primary" href="/{{ url_prefix[content_type] }}/{{ node.id }}/rss.xml">RSS <i class="bi bi-rss-fill"></i></a>
        {% endif %}
        {% if filters_enabled %}
          <a class="btn btn-primary d-md-none" data-bs-toggle="collapse" href="#full-work-filters" role="button" aria-expanded="true" aria-controls="full-work-filters">
            Filters <i class="bi bi-funnel-fill"></i>
          </a>
        {% endif %}
      </div>
      {% if has_image %}
        <img
          src="{{ file_url(node.field_cover[0].entity.uri.value) }}"
          alt="{{ node.field_cover[0].entity.alt.value }}"
        >
      {% endif %}
      {% if filters_enabled %}
        <div id="full-work-filters" class="full-work-filters collapse dont-collapse-sm">
          {% if content_type == "playlist" %}
            {{ drupal_block("views_exposed_filter_block:seriess-works", wrapper=false) }}
          {% elseif content_type == "reader_collection" %}
            {{ drupal_block("views_exposed_filter_block:reader_tags-works", wrapper=false) }}
          {% elseif content_type == "rec_list" %}
            {{ drupal_block("views_exposed_filter_block:rec_lists-works", wrapper=false) }}
          {% endif %}
        </div>
      {% endif %}
      <div class="d-flex flex-column w-100 full-work-main-content">
        <h1>{{ label }}</h1>

        <div class="d-flex justify-content-between align-items-center mb-2">
          <div class="d-flex flex-wrap gap-1 full-work-lozenges">
            {% if node.field_rating is not empty %}
              {{ content.field_rating }}
            {% else %}
              <span class="badge bg-secondary">Age Rating Unknown</span>
            {% endif %}

            {% if content_type == "playlist" %}
              <span class="badge bg-primary">Series</span>
            {% elseif content_type == "reader_collection" %}
              <span class="badge bg-primary">Reader Collection</span>
            {% elseif content_type == "rec_list" %}
              <span class="badge bg-primary">Rec List</span>
            {% elseif content_type == "legacy_work" %}
              <span class="badge bg-primary">Legacy Work</span>
            {% endif %}

            {# TODO: if open/closed status on series/collections stays: render it here as a WIP lozenge #}
            {{ content.field_completion_status }}
          </div>
          <div class="d-flex flex-column justify-content-end text-end full-work-dates">
            <small class="fw-bold">Published: {{ created_at }}</small>
            <small class="fw-bold">Last Updated: {{ updated_at }}</small>
          </div>
        </div>

        <div class="mb-2">
          {% if content_type == "work" %}
            {{ drupal_view("work", "player") }}
          {% elseif content_type == "playlist" %}
            {{ drupal_view("seriess", "player") }}
          {% elseif content_type == "reader_collection" %}
            {{ drupal_view("reader_tags", "player") }}
          {% elseif content_type == "rec_list" %}
            {{ drupal_view("rec_lists", "player") }}
          {% endif %}
        </div>

        <div class="alert alert-aa-metadata d-flex flex-column" role="alert">
          {{ content.field_curator }}

          {{ content.field_author }}

          {{ content.field_reader }}

          <div class="mb-1">
            {% for tag in all_tags %}
              {% set vocabulary = tag.vid.value[0]["target_id"] %}
              {% set fandom_or_ship = vocabulary in ["fandom", "relationship"] ? "fw-bolder" : "" %}
              {% set warning = vocabulary == "warning" ? "fst-italic" : "" %}
              {% set taxonomy_path = path('entity.taxonomy_term.canonical', {'taxonomy_term': tag.id}) %}
              <a class="{{ fandom_or_ship }} {{ warning }}" href="{{ taxonomy_path }}">{{ tag.name.value }}</a>{{- not loop.last ? ', ' -}}
            {% endfor %}
          </div>

          {% if node.field_length is not empty and content_type == "legacy_work" %}
            <span><b>Length</b> {{ node.field_length[0].entity.name.value }}</span>
          {% endif %}

          {% set duration %}
            {{ content.field_duration }}
          {% endset %}

          {% if node.field_duration is not empty and content_type != "legacy_work" %}
            <span><b>Duration</b> {{ duration|striptags|trim }}</span>
          {% endif %}

          {% if node.field_language is not empty %}
            <span><b>Language</b> {{ node.field_language[0].entity.name.value }}</span>
          {% endif %}

          {% if node.field_languages is not empty %}
            <span>
              <b>Language(s)</b>
              {% for lang in node.field_languages %}
                {{ lang.entity.name.value }}{{- not loop.last ? ', ' -}}
              {% endfor %}
            </span>
          {% endif %}

          {% if node.field_legacy_series is not empty %}
            {# TODO: Could fetch position in series as well, if we care to. #}
            {% set legacy_series = node.field_legacy_series[0].entity %}
            <span>
              <b>Part of Series</b>
              <a href="{{ path('entity.taxonomy_term.canonical', {'taxonomy_term': legacy_series.id}) }}">{{ legacy_series.name.value }}</a>
            </span>
          {% endif %}

          {% for series_pos in series_positions %}
            {% set series = series_pos['series'] %}
            <span>
              part {{ series_pos['position'] }} of
              <a href="{{ path('entity.node.canonical', {'node': series.id}) }}">{{ series.title.value }}</a>
            </span>
          {% endfor %}

          {% if node.field_reader_collections is not empty %}
            <span>
              <b>Part of Collection(s)</b>
              {% for collection in node.field_reader_collections %}
                <a href="{{ path('entity.node.canonical', {'node': collection.entity.id}) }}">{{ collection.entity.title.value }}</a>
              {% endfor %}
            </span>
          {% endif %}

          {# TODO: is this desireable? The work/collection creator has no way of
          deciding if this should appear. Should there instead be a reciprocal
          relationship, where if the reader can authorise the rec lists they want
          to display? #}
          {% if rec_lists is not empty %}
            <span>
              <b>Part of Rec List(s)</b>
              {% for rec_list in rec_lists %}
                <a href="{{ path('entity.node.canonical', {'node': rec_list.id}) }}">{{ rec_list.title.value }}</a>
              {% endfor %}
            </span>
          {% endif %}
        </div>

        {% if node.field_summary is not empty or node.field_notes is not empty %}
          <div>
            {% if node.field_summary is not empty %}
              <div>
                <b>Summary</b>
                <div class="ms-3">{{ content.field_summary }}</div>
              </div>
            {% endif %}

            {% if node.field_notes is not empty %}
              <div>
                <b>Notes</b>
                <div class="ms-3">{{ content.field_notes }}</div>
              </div>
            {% endif %}
          </div>
        {% endif %}

        {% if content_type in ["playlist", "reader_collection", "rec_list"] %}
          {# All works in this series as teasers #}
          <div>
            {% if explicit_rating and total_nsfw is not empty %}
              <span class="nsfw-total d-none">({{ total_nsfw }} work{{ total_nsfw > 1 ? 's' : ''}} on this page {{ total_nsfw > 1 ? 'are' : 'is'}} hidden by your filters.)</span>
            {% endif %}
            {% if content_type == "playlist" %}
              {{ drupal_view("seriess", "works") }}
            {% elseif content_type == "reader_collection" %}
              {{ drupal_view("reader_tags", "works") }}
            {% elseif content_type == "rec_list" %}
              {{ drupal_view("rec_lists", "works") }}
            {% endif %}
          </div>
        {% endif %}

        {% if content_type == "legacy_work" %}
          <div class="alert alert-aa-info" role="alert">
            Not all legacy works have all metadata (ratings, tags, warnings & summaries) please see the attribution links below before you listen.
          </div>
          {{ node.body.value | raw }}
        {% endif %}
      </div>
      <div class="full-work-links-downloads">
        {# TODO: not displaying attribution links for rec lists. Would need to edit this if we do decide
        we want to display them. #}
        {% set warning_text = "To leave feedback please see the" %}
        {% set warning_text_multiple = "written work(s) and podfic post(s)." %}

        {% if content_type == "work" and node.field_podfic_post.getvalue | length == 1 and node.field_text_post.getvalue | length == 1 %}
          <div class="alert alert-aa-info" role="alert">
            <p>
              {{ warning_text }}
              <a href="{{ node.field_text_post.value[0].uri }}">written work</a>
              and
              <a href="{{ node.field_podfic_post.value[0].uri }}">podfic post</a>.
            </p>
          </div>
        {% elseif content_type in ["work", "playlist", "reader_collection"] %}
          <div class="alert alert-aa-info" role="alert">
            <p>{{ warning_text }} {{ warning_text_multiple }}</p>
            {% set text_links = content_type == "work" ? node.field_text_post.value : work_text_links %}
            {% set podfic_links = content_type == "work" ? node.field_podfic_post.value : work_podfic_links %}
            <p>
              Written work(s):
              {% for link in text_links %}
                {# TODO: for multiple links on a single work use the links text field
                to add a label? #}
                {% set title = content_type == "work" ? "link %s"|format(loop.index) : link.title %}
                <a href="{{ link.uri }}">{{ title }}</a>{% if not loop.last %},{% endif %}
              {% endfor %}
            </p>
            <p>
              Podfic post(s):
              {% for link in podfic_links %}
                {% set title = content_type == "work" ? "link %s"|format(loop.index) : link.title %}
                <a href="{{ link.uri }}">{{ title }}</a>{% if not loop.last %},{% endif %}
              {% endfor %}
            </p>
          </div>
        {% endif %}

        {% if content_type == "work" %}
          {{ drupal_view("work", "downloads") }}
        {% elseif content_type == "playlist" %}
          {{ drupal_view("seriess", "downloads") }}
        {% elseif content_type == "reader_collection" %}
          {{ drupal_view("reader_tags", "downloads") }}
        {% elseif content_type == "rec_list" %}
          {% if legacy_works %}
            <div class="alert alert-aa-info" role="alert">
              This rec list contains legacy works which will not appear in the playlist
              or download sections. To stream or download these works, please navigate to their
              induvidual page via the complete list of works.
            </div>
          {% endif %}
          {{ drupal_view("rec_lists", "downloads") }}
        {% endif %}
      </div>
    </div>
  {% else %}
    {{ content }}
  {% endif %}
</div>
</article>
