{#
/**
 * @file
 * Theme override for a main view template.
 *
 * Available variables:
 * - attributes: Remaining HTML attributes for the element.
 * - css_name: A css-safe version of the view name.
 * - css_class: The user-specified classes names, if any.
 * - header: The optional header.
 * - footer: The optional footer.
 * - rows: The results of the view query, if any.
 * - empty: The content to display if there are no rows.
 * - pager: The optional pager next/prev links to display.
 * - exposed: Exposed widget form/info to display.
 * - feed_icons: Optional feed icons to display.
 * - more: An optional link to the next page of results.
 * - title: Title of the view, only used when displaying in the admin preview.
 * - title_prefix: Additional output populated by modules, intended to be
 *   displayed in front of the view title.
 * - title_suffix: Additional output populated by modules, intended to be
 *   displayed after the view title.
 * - attachment_before: An optional attachment view to be displayed before the
 *   view content.
 * - attachment_after: An optional attachment view to be displayed after the
 *   view content.
 * - dom_id: Unique id for every view being printed to give unique class for
 *   Javascript.
 *
 * @see template_preprocess_views_view()
 */
#}
{% if view.id == "search" and view.current_display == "search_taxonomy" and taxonomy_term.bundle == "series" %}
  <div class="p-2 full-work no-image legacy-series">
      <div class="d-flex flex-column w-100 full-work-main-content">
        <h1>{{ taxonomy_term.name.value }}</h1>

        <div class="d-flex justify-content-between align-items-center mb-2">
          <div class="d-flex flex-wrap gap-1 full-work-lozenges">
            {# TODO: Actually calculate this! Not decided on the priority of ratings, but keep in mind that one of the options is NULL #}
            <span class="badge bg-secondary me-1">Age Rating Unknown</span>
            <span class="badge bg-primary me-1">Legacy Series</span>
          </div>
          <div class="d-flex flex-column justify-content-end text-end full-work-dates">
            {% if created_at is not empty %}
              <small class="fw-bold">Published: {{ created_at }}</small>
            {% endif %}
            <small class="fw-bold">Last Updated: {{ updated_at }}</small>
          </div>
        </div>

        <div class="alert alert-aa-metadata d-flex flex-column" role="alert">
          <span>
            <span class="work-field-label">Written by</span>
            {% for author in authors %}
              {% set taxonomy_path = path('entity.taxonomy_term.canonical', {'taxonomy_term': author.id}) %}
              <a href="{{ taxonomy_path }}">{{ author.name.value }}</a>{{- not loop.last ? ', ' -}}
            {% endfor %}
          </span>

          <span>
            <span class="work-field-label">Read by</span>
            {% for reader in readers %}
              {% set taxonomy_path = path('entity.taxonomy_term.canonical', {'taxonomy_term': reader.id}) %}
              <a href="{{ taxonomy_path }}">{{ reader.name.value }}</a>{{- not loop.last ? ', ' -}}
            {% endfor %}
          </span>

          <div class="mb-1">
            {% for tag in all_tags %}
              {% set vocabulary = tag.vid.value[0]["target_id"] %}
              {% set fandom_or_ship = vocabulary in ["fandom", "relationship"] ? "fw-bolder" : "" %}
              {% set taxonomy_path = path('entity.taxonomy_term.canonical', {'taxonomy_term': tag.id}) %}
              <a class="{{ fandom_or_ship }}" href="{{ taxonomy_path }}">{{ tag.name.value }}</a>{{- not loop.last ? ', ' -}}
            {% endfor %}
          </div>

          <span>
            <b>Language(s)</b>
            {% for lang in languages %}
              {{ lang.name.value }}{{- not loop.last ? ', ' -}}
            {% endfor %}
          </span>
        </div>

        {# All works in this series as teaser-full (teaser + body text) #}
        <div class="mt-2">
          {% if total_nsfw > 0 %}
            <span class="nsfw-total d-none">({{ total_nsfw }} work{{ total_nsfw > 1 ? 's' : ''}} on this page {{ total_nsfw > 1 ? 'are' : 'is'}} hidden by your filters.)</span>
          {% endif %}
          {{ drupal_view("search", "legacy_series_block") }}
        </div>
      </div>
  </div>
{% else %}
  {%
    set classes = [
      'view',
      'view-' ~ id|clean_class,
      'view-id-' ~ id,
      'view-display-id-' ~ display_id,
      dom_id ? 'js-view-dom-id-' ~ dom_id,
    ]
  %}
  {% if view.current_display == "search_taxonomy" %}
    {% set form_target = "block-bootstrap-barrio-subtheme-exposedformsearchsearch-taxonomy" %}
    {% set tag_info_btn %}
      <a class="btn btn-primary ms-1" data-bs-toggle="collapse" href="#tagInfo" role="button" aria-expanded="true" aria-controls="tagInfo">
        Tag Info <i class="bi bi-info-circle-fill"></i>
      </a>
    {% endset %}
    {% if taxonomy_term != NULL and
          taxonomy_term.bundle in ["author", "reader", "curator", "cover_artist"] and
          user is not empty %}
      {% set user_profile_btn %}
        <a class="btn btn-primary ms-1" href="/user/{{ user.id }}">View User Profile <i class="bi bi-person-fill"></i></a>
      {% endset %}
    {% endif %}
  {% elseif view.current_display == "search" %}
    {% set form_target = "block-bootstrap-barrio-subtheme-exposedformsearchsearch" %}
    {% set other_search %}
      <a class="btn btn-primary ms-1" href="/search/collections">Search Collections</a>
    {% endset %}
  {% elseif view.current_display == "search_collection" %}
    {% set form_target = "block-bootstrap-barrio-subtheme-exposedformsearchsearch-collection" %}
    {% set other_search %}
      <a class="btn btn-primary ms-1" href="/search/works">Search Works</a>
    {% endset %}
  {% endif %}
  <div{{ attributes.addClass(classes) }}>
    {{ title_prefix }}
    {% if title %}
      {{ title }}
    {% endif %}
    {{ title_suffix }}
    {% if view.current_display == "search_taxonomy" and taxonomy_term != NULL %}
      <div id="tagInfo" class="collapse">
        {# TODO: Add type of fandom tag after a comma (This tag is a Fandom tag, in the category Movie & TV Fandoms). #}
        <p>This tag is a {{ taxonomy_term.bundle|replace({"_": " "})|title }} tag.</p>

        {% if term_parent is not empty %}
          {% set taxonomy_path = path('entity.taxonomy_term.canonical', {'taxonomy_term': term_parent.id}) %}
          <p><b>Parent Tag:</b> <a href="{{ taxonomy_path }}">{{ term_parent.name.value }}</a></p>
        {% endif %}

        {% if term_children is not empty %}
          <p>
            <b>Child Tag(s):</b>
            {% for child in term_children %}
              {% set taxonomy_path = path('entity.taxonomy_term.canonical', {'taxonomy_term': child.id}) %}
              <a href="{{ taxonomy_path }}">{{ child.name.value }}</a>{{- not loop.last ? ', ' -}}
            {% endfor %}
          </p>
        {% endif %}

        {# TODO: non-canonical siblings if/when we add them #}

        {% if taxonomy_term.bundle in ["author", "reader", "curator", "cover_artist"] %}
          {% if user is not empty %}
            <p>View this user's profile page <a href="/user/{{ user.id }}">here</a>.</p>
          {% endif %}

          {% if pseudonyms is not empty %}
            <p>
              This user also has works archived under the following names:
              {% for tag in pseudonyms %}
                {% set taxonomy_path = path('entity.taxonomy_term.canonical', {'taxonomy_term': tag.id}) %}
                <a href="{{ taxonomy_path }}">{{ tag.name.value }} ({{ tag.bundle|replace({"_": " "})|title }})</a>{{- not loop.last ? ', ' -}}
              {% endfor %}
            </p>
          {% endif %}
        {% endif %}
      </div>
    {% endif %}
    {% if header %}
      <div class="view-header">
        {{ header }}
        {% if total_nsfw > 0 %}
          <span class="nsfw-total d-none">({{ total_nsfw }} work{{ total_nsfw > 1 ? 's' : ''}} on this page {{ total_nsfw > 1 ? 'are' : 'is'}} hidden by your filters.)</span>
        {% endif %}
      </div>
    {% endif %}
    {% if exposed %}
      <div class="view-filters">
        {{ exposed }}
      </div>
    {% endif %}
    {% if attachment_before %}
      <div class="attachment attachment-before">
        {{ attachment_before }}
      </div>
    {% endif %}

    {# Contextual Menu #}
    {% if view.id == "search" and view.current_display in ["search", "search_collection", "search_taxonomy"] %}
      <div class="mb-2 contextual-menu d-flex justify-content-end">
        {{ other_search }}
        {{ tag_info_btn }}
        {{ user_profile_btn }}
        {% if view.current_display != "search_collection" %}
        <a class="btn btn-primary ms-1" id="rssLink" href="{{ rss_feed }}">RSS <i class="bi bi-rss-fill"></i></a>
        {% endif %}
        <a id="expand-filters" class="btn btn-primary d-md-none ms-1" data-bs-toggle="collapse" href="#{{ form_target }}" role="button" aria-expanded="true" aria-controls="{{ form_target }}">
          Filters <i class="bi bi-funnel-fill"></i>
        </a>
      </div>
    {% endif %}

    {% if pager %}
      {{ pager }}
    {% endif %}

    {% if rows %}
      <div class="view-content row">
        {{ rows }}
      </div>
    {% elseif empty %}
      <div class="view-empty">
        {{ empty }}
      </div>
    {% endif %}

    {% if pager %}
      {{ pager }}
    {% endif %}
    {% if attachment_after %}
      <div class="attachment attachment-after">
        {{ attachment_after }}
      </div>
    {% endif %}
    {% if more %}
      {{ more }}
    {% endif %}
    {% if footer %}
      <div class="view-footer">
        {{ footer }}
      </div>
    {% endif %}
    {% if feed_icons %}
      <div class="feed-icons">
        {{ feed_icons }}
      </div>
    {% endif %}
  </div>
{% endif %}
