{#
/**
 * @file
 * Theme override for a views exposed form.
 *
 * Available variables:
 * - form: A render element representing the form.
 *
 * @see template_preprocess_views_exposed_form()
 */
#}

{# {{ dump(form) }} #}

{% if q is not empty %}
  {#
    This ensures that, if clean URLs are off, the 'q' is added first,
    as a hidden form element, so that it shows up first in the POST URL.
  #}
{{ q }}
{% endif %}
{# <div class="d-flex flex-wrap">
  {{ form }}
</div> #}

{{ form.form_build_id }}
{{ form.form_token }}
{{ form.form_id }}

<div class="d-flex flex-column">
  <div>
    {{ form.search_api_fulltext }}
  </div>
  <div>
    {{ form.field_category }}
  </div>
  <div>
    {{ form.field_rating }}
  </div>
  <div>
    {{ form.field_warning }}
  </div>
  <div>
    {{ form.field_fandom2 }}
  </div>
  <div>
    {{ form.field_relationship }}
  </div>
  <div>
    {{ form.field_format }}
  </div>
  <div>
    {{ form.field_length }}
  </div>
  <div>
    {{ form.field_author }}
  </div>
  <div>
    {{ form.field_reader }}
  </div>
  <div>
    {{ form.field_language }}
  </div>
  <div>
    {{ form.field_completion_status }}
  </div>
  <div>
    {{ form.sort_by }}
  </div>
  <div>
    {{ form.actions }}
  </div>
</div>
