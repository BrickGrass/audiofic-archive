{#
/**
 * @file
 * Theme override for a views exposed form.
 *
 * Available variables:
 * - form: A render element representing the form.
 *
 * @see template_preprocess_views_exposed_form()
 */
#}

{% if q is not empty %}
  {#
    This ensures that, if clean URLs are off, the 'q' is added first,
    as a hidden form element, so that it shows up first in the POST URL.
  #}
{{ q }}
{% endif %}

{{ form.form_build_id }}
{{ form.form_token }}
{{ form.form_id }}

<div class="d-flex flex-column">
  <div class="mb-2">
    {{ form.actions.submit }}
  </div>

  <div>
    {{ form.search_api_fulltext }}
  </div>
  <div>
    {{ form.sort_by }}
    {{ form.sort_bef_combine }}
  </div>
  <div>
    {{ form.duration_fieldset }}
  </div>

  <h5>Include</h5>
  <div>
    {{ form.category }}
  </div>
  <div>
    {{ form.rating }}
  </div>
  <div>
    {{ form.warning }}
  </div>
  <div>
    {{ form.language }}
  </div>
  <div>
    {{ form.fandom }}
  </div>
  <div>
    {{ form.relationship }}
  </div>
  <div>
    {{ form.format }}
  </div>
  <div>
    {{ form.reader }}
  </div>
  <div>
    {{ form.author }}
  </div>

  <h5>Exclude</h5>
  <div>
    {{ form["category-exclude"] }}
  </div>
  <div>
    {{ form["rating-exclude"] }}
  </div>
  <div>
    {{ form["warning-exclude"] }}
  </div>
  <div>
    {{ form["language-exclude"] }}
  </div>
  <div>
    {{ form["fandom-exclude"] }}
  </div>
  <div>
    {{ form["relationship-exclude"] }}
  </div>
  <div>
    {{ form["format-exclude"] }}
  </div>
  <div>
    {{ form["reader-exclude"] }}
  </div>
  <div>
    {{ form["author-exclude"] }}
  </div>

  <h5>Additional Options</h5>
  <div>
    {{ form.completion }}
  </div>

  <div class="{{ form.actions.reset['#access'] ? 'mb-2' : '' }}">
    {{ form.actions.reset }}
  </div>
  <div>
    {{ form.actions.submit }}
  </div>
</div>
