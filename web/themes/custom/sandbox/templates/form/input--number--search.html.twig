{#
/**
 * @file
 * Theme override for an 'input' #type form element.
 *
 * Available variables:
 * - attributes: A list of HTML attributes for the input element.
 * - children: Optional additional rendered elements.
 *
 * @see template_preprocess_input()
 */
#}

<input {{ attributes.addClass("d-none", "aa-duration-hidden").removeClass("form-text") }}>
{% set attributes = attributes.removeClass("d-none", "aa-duration-hidden")
                              .removeAttribute("id")
                              .removeAttribute("value")
                              .removeAttribute("data-drupal-selector")
                              .removeAttribute("name")
                              .setAttribute("data-aa-duration-for", element['#attributes']['id'])
                              .setAttribute("type", "text")
                              .setAttribute("inputmode", "numeric")
                              .setAttribute("pattern", "[0-9]*")
                              .addClass("form-control", "form-control-sm", "aa-duration")
%}

{% set title = element['#title'] %}

{# No max for HH, max of 59 for MM & SS #}
<div class="d-flex flex-row aa-duration-wrapper justify-content-end align-items-center ms-2">
  <input {{ attributes.setAttribute("placeholder", "HH").setAttribute("aria-label", "Duration %s: hours"|format(title)) }} value="{{ hours is not empty ? hours : '' }}">
  <span class="ms-1 me-1">:</span>
  <input {{ attributes.setAttribute("max", "59").setAttribute("placeholder", "MM").setAttribute("aria-label", "Duration %s: minutes"|format(title)) }} value="{{ mins is not empty ? mins : '' }}">
  <span class="ms-1 me-1">:</span>
  <input {{ attributes.setAttribute("placeholder", "SS").setAttribute("aria-label", "Duration %s: seconds"|format(title)) }} value="{{ seconds is not empty ? seconds : '' }}">
</div>
