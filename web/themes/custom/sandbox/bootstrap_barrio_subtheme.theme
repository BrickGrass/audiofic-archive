<?php

/**
 * @file
 * Functions to support theming in the SASS Starterkit subtheme.
 */

/**
 * Prepares variables for `breadcrumb.html.twig`.
 */
function bootstrap_barrio_subtheme_preprocess_breadcrumb(&$variables) {
  // Remove 'Home' from breadcrumb trail.
  if (count($variables['breadcrumb'])) {
    array_shift($variables['breadcrumb']);
  }
}

/**
 * Implements hook_preprocess_node().
 */
function bootstrap_barrio_subtheme_preprocess_node(&$variables) {
  $node = $variables["node"];
  $node_type = $node->getType();
  /** @var \Drupal\aa_utils\Service\AudioficUtils $utils */
  $utils = \Drupal::service('aa_utils.utils');

  if (in_array($node_type, ["work", "legacy_work", "playlist", "reader_collection", "rec_list"])) {
    $all_tags = [];

    foreach (['field_warning', 'field_fandom2', 'field_relationship', 'field_category', 'field_format'] as $key) {
      $utils->fetchVocabTerms($node, $key, $all_tags);
    }

    $variables["all_tags"] = $all_tags;

    $date_formatter = \Drupal::service('date.formatter');
    $created_date = $date_formatter->format($node->getCreatedTime(), "custom", "j F Y");
    $variables['created_at'] = $created_date;

    $updated_date = $date_formatter->format($node->getChangedTime(), "custom", "j F Y");
    $variables['updated_at'] = $updated_date;
  }

  if ($variables['view_mode'] === 'full' && $node_type === 'work') {
    $series_positions = [];

    foreach ($node->get('field_series')->referencedEntities() as $series) {
      $i = 1;
      foreach ($series->get('field_works_series')->referencedEntities() as $series_work) {
        if ($node->id() === $series_work->id()) {
          $series_positions[] = ['series' => $series, 'position' => $i];
          break;
        }
        $i++;
      }
    }

    $variables['series_positions'] = $series_positions;
  }

  if ($variables['view_mode'] === 'full') {
    // Find out if this node is on any rec lists
    $rec_list_ids = \Drupal::entityQuery('node')
      ->condition('type', 'rec_list')
      ->condition('field_works.entity:node.nid', $node->id())
      ->accessCheck(TRUE)
      ->execute();
    $variables['rec_lists'] = \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($rec_list_ids);
  }

  // TODO: add query for rec_lists so they can list work attribution links!
  if (in_array($node_type, ["playlist", "reader_collection", "rec_list"])) {
    $results = NULL;

    if (in_array($node_type, ['playlist', 'reader_collection'])) {
      $condition = $node_type === "playlist" ? "field_series.entity:node.nid" : "field_reader_collections.entity:node.nid";
      $results = \Drupal::entityQuery('node')
        ->condition('type', 'work')
        ->condition($condition, $node->id())
        ->accessCheck(TRUE)
        ->execute();
      $variables["collection_length"] = count($results);
    }

    if ($variables["view_mode"] === "full" and $node_type === "rec_list") {
      $rec_list_works = $node->get("field_works")->referencedEntities();

      // TODO: not collecting attribution links because we're unsure if we're displaying them.
      // Will be easy to add them if we do decide to.
      $legacy_works = FALSE;
      foreach ($rec_list_works as $rec_list_work) {
        if ($rec_list_work->getType() === "legacy_work") {
          $legacy_works = TRUE;
        }
      }

      $variables['total_nsfw'] = $utils->getTotalNsfw($rec_list_works);
      $variables['legacy_works'] = $legacy_works;
    }

    if ($variables["view_mode"] === "full" and in_array($node_type, ["playlist", "reader_collection"]) and $results !== NULL) {
      $works = \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($results);

      $work_text_links = [];
      $work_podfic_links = [];
      $total_nsfw = $utils->getTotalNsfw($works);

      foreach ($works as $work) {
        $links = $work->get("field_text_post");
        if (count($links) == 1) {
          add_link($work_text_links, $links[0]->uri, $work);
        } else {
          $index = 1;
          foreach ($links as $link) {
            add_link($work_text_links, $link->uri, $work, $index);
            $index++;
          }
        }

        $links = $work->get("field_podfic_post");
        if (count($links) == 1) {
          add_link($work_podfic_links, $links[0]->uri, $work);
        } else {
          $index = 1;
          foreach ($links as $link) {
            add_link($work_podfic_links, $link->uri, $work, $index);
            $index++;
          }
        }
      }

      $variables['work_text_links'] = $work_text_links;
      $variables['work_podfic_links'] = $work_podfic_links;
      $variables['total_nsfw'] = $total_nsfw;
    }
  }
}

/**
 * Implements template_preprocess_field().
 */
function bootstrap_barrio_subtheme_preprocess_field(&$variables) {
  $variables['view_mode'] = $variables['element']['#view_mode'];
}

/**
 * Function to add a link to an array.
 */
function add_link(&$links, $uri, $work, $index = NULL) {
  $title = $index == NULL ? $work->getTitle() : "{$work->getTitle()} {$index}";
  $links[] = ["uri" => $uri, "title" => $title];
}
