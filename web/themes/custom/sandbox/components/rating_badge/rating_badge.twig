{% set margin = view_mode == 'full' ? 'me-1' : 'ms-1' %}


{% set alt = "Rating: " + rating | trans %}
{% if rating == "Explicit" %}
  <span class="badge bg-danger {{ margin }}" title="{{ alt }}" aria-label="{{ alt }}">E</span>
{% elseif rating == "Mature" %}
  <span class="badge rating-mature {{ margin }}" title="{{ alt }}" aria-label="{{ alt }}">M</span>
{% elseif rating == "Teen and up" %}
  <span class="badge bg-warning {{ margin }}" title="{{ alt }}" aria-label="{{ alt }}">T</span>
{% elseif rating == "General" %}
  <span class="badge bg-success {{ margin }}" title="{{ alt }}" aria-label="{{ alt }}">G</span>
{% elseif rating == "Not rated" %}
  <span class="badge bg-secondary {{ margin }}">{% trans %}No Age Rating{% endtrans %}</span>
{% else %}
  <span class="badge bg-secondary {{ margin }}">{% trans %}Age Rating Unknown{% endtrans %}</span>
{% endif %}
