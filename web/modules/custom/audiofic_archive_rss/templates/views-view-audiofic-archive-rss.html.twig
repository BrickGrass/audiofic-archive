{#
/**
 * @file
 * Theme override for feed displays that use the RSS style.
 *
 * Available variables:
 * - link: The link to the feed (the view path).
 * - namespaces: The XML namespaces (added automatically).
 * - title: The title of the feed (as set in the view).
 * - description: The feed description (from feed settings).
 * - langcode: The language encoding.
 * - channel_elements: The formatted channel elements.
 * - items: The feed items themselves.
 *
 * @see template_preprocess_views_view_rss()
 */
#}
<?xml version="1.0" encoding="utf-8" ?>
<rss version="2.0" xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd">
  <channel>
    {% if options.is_contextual %}
      <title>{{ source_node.title }}</title>
      <description>{{ source_node.description }}</description>
      <link>{{ source_node.link }}</link>
      {% if source_node.cover_url != NULL %}
      <itunes:image href="https://dev-audiofic.pantheonsite.io{{ source_node.cover_url }}"/>
      {% endif %}
      <!-- TODO: Fallback cover if none is present on contextual work/series? -->
    {% else %}
      <title>{{ options.title }}</title>
      <description>{{ options.description }}</description>
      <!-- TODO: Create a placeholder image attached to the module which gets loaded for non-contextual feeds? Just our logo maybe? -->
      <!-- TODO: For now assume that all our search feeds are nsfw. -->
      <itunes:explicit>true</itunes:explicit>
      <link>{{ url('<current>') }}</link>
    {% endif %}
    <language>en</language>
    {% for work in works %}
      {% for file in work.files %}
        <item>
          <itunes:episodeType>full</itunes:episodeType>
          <title>{{ work.title }} {{ file.name }}</title>
          <itunes:title>{{ work.title }} {{ file.name }}</itunes:title>
          <description>{{ work.tags }}</description>
          <enclosure
            length="{{ file.file_size }}"
            type="{{ file.mime_type }}"
            url="https://dev-audiofic.pantheonsite.io{{ file.url }}"
          />
          <guid isPermaLink="false">{{ file.uuid }}</guid>
          <pubDate>{{ file.date_created|date("D, j M Y H:m:s T") }}</pubDate>
          <itunes:duration>{{ file.duration }}</itunes:duration>
          <itunes:explicit>{{ work.explicit ? 'true' : 'false' }}</itunes:explicit>
          <link>https://dev-audiofic.pantheonsite.io{{ work.link }}</link>
          {% if work.cover_url != NULL %}
          <itunes:image href="https://dev-audiofic.pantheonsite.io{{ work.cover_url }}" />
          {% endif %}
        </item>
      {% endfor %}
    {% endfor %}
  </channel>
</rss>
