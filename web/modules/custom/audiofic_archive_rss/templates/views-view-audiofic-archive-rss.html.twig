{#
/**
 * @file
 * Theme override for feed displays that use the RSS style.
 *
 * Available variables:
 * - link: The link to the feed (the view path).
 * - namespaces: The XML namespaces (added automatically).
 * - title: The title of the feed (as set in the view).
 * - description: The feed description (from feed settings).
 * - langcode: The language encoding.
 * - channel_elements: The formatted channel elements.
 * - items: The feed items themselves.
 *
 * @see template_preprocess_views_view_rss()
 */
#}
<?xml version="1.0" encoding="utf-8" ?>
<rss version="2.0" xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd">
  <channel>
    <title>{{ options.title | trim }}</title>
    <link>https://{{ hostname }}{{ options.link }}</link>
    <description>{{ options.description | trim }}</description>
    <language>en</language>
    {% if options.is_contextual and contextual_filter == "node" %}
      {% if source_node.cover_url != NULL %}
      <itunes:image href="{{ source_node.cover_url }}"/>
      {% elseif options.cover_url|trim is not empty %}
      <itunes:image href="https://{{ hostname }}{{ options.cover_url }}"/>
      {% endif %}
      <itunes:explicit>{{ source_node.explicit ? 'true' : 'false' }}</itunes:explicit>
    {% else %}
      {% if options.cover_url|trim is not empty %}
      <itunes:image href="https://{{ hostname }}{{ options.cover_url }}"/>
      {% endif %}
      <itunes:explicit>{{ explicit ? 'true' : 'false' }}</itunes:explicit>
    {% endif %}
    {% for key, url in pagination %}
      <link rel="{{ key }}" href="{{ url | raw }}"/>
    {% endfor %}
    {% for work in works %}
      {% for file in work.files %}
        <item>
          <itunes:episodeType>full</itunes:episodeType>
          {% if file.name %}
            {% set part_title = work.title ~ file.name %}
          {% else %}
            {% set part_title = work.title %}
          {% endif %}
          <title>{{ part_title }}</title>
          <itunes:title>{{ part_title }}</itunes:title>
          <description><![CDATA[{{ file.part_no }}{% for series_link in file.series_links %}{{ series_link }}{% endfor %}<p>{% for label, content in work.tags %}<b>{{label}}</b>{{content}}</br>{% endfor %}</p>{{ work.summary | raw }}]]></description>
          <enclosure
            length="{{ file.file_size }}"
            type="{{ file.mime_type }}"
            url="https://{{ hostname }}{{ file.url }}"
          />
          <guid isPermaLink="false">{{ file.uuid }}</guid>
          <pubDate>{{ file.date_created|date("D, j M Y H:m:s T") }}</pubDate>
          <itunes:duration>{{ file.duration }}</itunes:duration>
          <itunes:explicit>{{ work.explicit ? 'true' : 'false' }}</itunes:explicit>
          <link>https://{{ hostname }}/{{ work.link }}</link>
          {% if work.cover_url != NULL %}
          <itunes:image href="{{ work.cover_url }}" />
          {% endif %}
        </item>
      {% endfor %}
    {% endfor %}
  </channel>
</rss>
