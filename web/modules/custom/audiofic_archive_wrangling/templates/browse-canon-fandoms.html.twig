{% set edit_url = top_level ? '/admin/structure/taxonomy/wrangling/wrangle-root-fandom/' : '/admin/structure/taxonomy/wrangling/wrangle-canonical/' %}

{% if top_level %}
<div class="fandom-tree-button-container">
  <a id="toggleLineColours" href="#" role="button">Toggle line colours</a>
</div>
{% endif %}

<ul class="{{ top_level ? 'fandom-tree' : '' }}">
  {% for tid, fandom in fandoms %}
  <li
    data-tid="{{ tid }}"
    class="{{ fandom.has_children ? '' : 'fandom-tree-leaf' }}"
    title="{{ fandom.parents }}"
  >
    {% if fandom.has_children %}
    <details data-tid="{{ tid }}" data-children-loaded="false">
      <summary><span aria-label="expand group">{{ fandom.name }}</span><a aria-label="edit fandom {{ fandom.name }}" href="{{ edit_url }}{{ tid }}">edit</a></summary>
      <ul></ul>
    </details>
    {% else %}
      <span>{{ fandom.name }}</span><a aria-label="edit fandom {{ fandom.name }}" href="{{ edit_url }}{{ tid }}">edit</a>
    {% endif %}
  </li>
  {% endfor %}
</ul>
